# ==============================================================================
# KONFIGURASI SUPABASE (JURNAL 7 KEBIASAAN ANAK INDONESIA HEBAT)
# Salin file ini menjadi .env atau .env.local dan isi kredensial dari project Supabase Anda
# ==============================================================================

# URL Project Supabase (Dapat dilihat di Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Anon Public Key (Dapat dilihat di Project Settings -> API -> Project API keys -> anon public)
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here
